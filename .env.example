# Copy this file to .env at the repo root and fill in values.
# The FastAPI app reads from .env via pydantic-settings.

# Claude / Anthropic
ANTHROPIC_API_KEY=

# YouTube Data API v3 (free tier, 10k units/day)
YOUTUBE_API_KEY=

# OBS WebSocket v5 (Tools → WebSocket Server Settings in OBS)
OBS_WS_HOST=localhost
OBS_WS_PORT=4455
OBS_WS_PASS=
OBS_SOURCE_NAME=RUNDOWN Overlay
